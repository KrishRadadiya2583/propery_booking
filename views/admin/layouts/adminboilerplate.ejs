<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>
  <link rel="stylesheet" href="/css/admindashboard.css">
</head>

<body>

<div class="admin-container">

  <!-- Sidebar -->
  <aside class="sidebar">
  <h2 class="logo">
  <svg class="logo-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2L2 7v7c0 5 5 9 10 9s10-4 10-9V7l-10-5z" fill="#3b82f6"/>
    <path d="M12 12l-3 3h6l-3-3z" fill="#fff"/>
  </svg>
  <span class="logo-text">AdminPro</span>
</h2>

    <nav>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/listings">Listings</a>
      <a href="/admin/bookings">Bookings</a>
      <a href="/admin/users">Users</a>
      <a href="/admin/logout">Logout</a>
    </nav>
  </aside>

  <!-- Main Area -->
  <main class="main-content">

    <!-- Topbar -->
    <header class="topbar">
      <h1>Admin Panel</h1>
       
      <div class="admin-profile"><span class="icon">👤</span>Admin</div>
    </header>
      <div class="flash-container">
      <% if (success.length> 0) { %>
        <div class="flash success">
          <%= success[0] %>
        </div>
        <% } %>

          <% if (error.length> 0) { %>
            <div class="flash error">
              <%= error[0] %>
            </div>
            <% } %>
    </div>

    <!-- Page Content -->
    <section class="page-content">
      <%- body %>
    </section>

  </main>

</div>

</body>
</html>
