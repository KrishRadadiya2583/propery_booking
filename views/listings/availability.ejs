<% layout("layouts/boilerplate") %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <div class="container mt-5">
        <div class="availability-glass p-4">

            <h2 class="text-center mb-4 neon-title">
                Availability for <span>
                    <%= listing.title %>
                </span>
            </h2>

            <!-- Legend -->
            <div class="legend mb-4">
                <div class="legend-item">
                    <span class="legend-color booked-box"></span>
                    Booked
                </div>
                <div class="legend-item">
                    <span class="legend-color available-box"></span>
                    Available
                </div>
            </div>

            <!-- Calendar -->
            <div class="calendar-wrapper">
                <div id="calendar"></div>
            </div>

            <div class="text-center mt-4">
                <a href="/listings/<%= listing._id %>" class="neon-btn">
                    Back to Listing
                </a>
            </div>

        </div>
    </div>

    <style>
        body {
            background: var(--bg-body);
            color: var(--text-main);
        }

        /* Glass Card */
        .availability-glass {
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            box-shadow: var(--shadow-lg);
            max-width: 650px;
            margin: auto;
        }

        /* Title */
        .neon-title span {
            color: var(--primary);
            text-shadow: 0 0 15px var(--primary-glow);
        }

        /* Legend */
        .legend {
            display: flex;
            justify-content: center;
            gap: 40px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-color {
            width: 18px;
            height: 18px;
            border-radius: 6px;
        }

        .booked-box {
            background: var(--accent);
            box-shadow: 0 0 12px var(--accent-glow);
        }

        .available-box {
            background: var(--primary);
            box-shadow: 0 0 12px var(--primary-glow);
        }

        .calendar-wrapper {
            display: flex;
            justify-content: center;
        }

        /* Flatpickr base */
        .flatpickr-calendar {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            color: var(--text-main);
        }

        /* Month title */
        .flatpickr-current-month {
            color: var(--text-main);
            font-weight: 600;
        }

        /* Weekday names */
        .flatpickr-weekday {
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* Day numbers */
        .flatpickr-day {
            color: var(--text-main);
            border-radius: 8px;
        }

        /* Hover effect */
        .flatpickr-day:hover {
            background: var(--bg-secondary);
            color: var(--text-main);
        }

        /* Today highlight */
        .flatpickr-day.today {
            border: 1px solid var(--primary);
            color: var(--primary);
        }

        /* Available */
        .available {
            background: rgba(79, 140, 255, 0.25) !important;
            border: 1px solid var(--primary);
            box-shadow: 0 0 8px var(--primary-glow);
            color: #ffffff !important;
        }

        /* Booked */
        .booked {
            background: rgba(255, 79, 216, 0.25) !important;
            border: 1px solid var(--accent);
            box-shadow: 0 0 8px var(--accent-glow);
            color: #ffffff !important;
        }

        /* Navigation arrows */
        .flatpickr-prev-month,
        .flatpickr-next-month {
            color: var(--text-main);
            fill: var(--text-main);
        }

        .flatpickr-prev-month:hover,
        .flatpickr-next-month:hover {
            color: var(--primary);
        }

        /* Neon Button */
        .neon-btn {
            display: inline-block;
            padding: var(--btn-padding);
            border-radius: var(--btn-radius);
            background: var(--primary);
            color: white;
            text-decoration: none;
            transition: var(--btn-transition);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .neon-btn:hover {
            background: var(--primary-hover);
            box-shadow: 0 0 25px var(--primary-glow);
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        const LISTING_ID = "<%= listing._id %>";
        let bookedDates = <%- JSON.stringify(dates) %>;

        function toRanges(list) {
            return list.map(b => ({ from: new Date(b.checkIn), to: new Date(b.checkOut) }));
        }
        let disabledRanges = toRanges(bookedDates);

        const picker = flatpickr("#calendar", {
            inline: true,
            minDate: "today",
            disable: disabledRanges,
            onDayCreate: function (dObj, dStr, fp, dayElem) {
                const date = dayElem.dateObj;
                let isBooked = disabledRanges.some(range => date >= range.from && date <= range.to);
                if (isBooked) dayElem.classList.add("booked");
                else dayElem.classList.add("available");
            }
        });

        async function refreshFromServer() {
            try {
                const r = await fetch(`/api/v1/listings/${LISTING_ID}/availability`);
                const j = await r.json();
                if (j && j.data && Array.isArray(j.data.bookedRanges)) {
                    bookedDates = j.data.bookedRanges;
                    disabledRanges = toRanges(bookedDates);
                    picker.set("disable", disabledRanges);
                    picker.redraw();
                }
            } catch (e) {}
        }

        if (window.WL_SOCKET) {
            window.WL_JOIN_LISTING && window.WL_JOIN_LISTING(LISTING_ID);
            window.WL_SOCKET.on("listing:booked", function (payload) {
                if (!payload || payload.listingId !== LISTING_ID) return;
                if (window.WL_TOAST) window.WL_TOAST({ badge: "BOOKED", title: "New booking just came in", message: (payload.checkIn || "") + " → " + (payload.checkOut || "") });
                refreshFromServer();
            });
            window.WL_SOCKET.on("listing:cancelled", function (payload) {
                if (!payload || payload.listingId !== LISTING_ID) return;
                if (window.WL_TOAST) window.WL_TOAST({ badge: "OPENED", title: "Booking cancelled — dates open", message: (payload.checkIn || "") + " → " + (payload.checkOut || "") });
                refreshFromServer();
            });
        }
    </script>