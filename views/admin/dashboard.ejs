<%- layout("./admin/layouts/adminboilerplate.ejs") %>

  <h1 class="dashboard-title">Admin Dashboard</h1>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="card-icon">🏠</div>
      <div class="card-info">
        <h3>Total Listings</h3>
        <p>
          <%= totalListings %>
        </p>
      </div>
    </div>

    <div class="stat-card">
      <div class="card-icon">👤</div>
      <div class="card-info">
        <h3>Total Users</h3>
        <p>
          <%= totalUsers %>
        </p>
      </div>
    </div>

    <div class="stat-card">
      <div class="card-icon">📅</div>
      <div class="card-info">
        <h3>Total Bookings</h3>
        <p>
          <%= totalBookings %>
        </p>
      </div>
    </div>

    <div class="stat-card">
      <div class="card-icon">💰</div>
      <div class="card-info">
        <h3>Revenue</h3>
        <p>$<%= totalRevenue %>
        </p>
      </div>
    </div>


  </div>


  <section class="recent-section">
    <h2>Recent Bookings</h2>
    <ul class="recent-list">
      <% recentBookings.forEach(booking=> { %>
        <li>
          <%= booking.userEmail %> booked <%= booking.listingTitle %> - $<%= booking.totalPrice %>
        </li>
        <% }) %>
    </ul>
  </section>