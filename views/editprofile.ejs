<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Profile</title>

  <style>
    :root {
      /* Neon primary accent */
      --primary: #4f8cff;
      --primary-hover: #7aa7ff;

      /* Backgrounds */
      --bg-body: radial-gradient(circle at 20% 20%,
          #0a0f2c,
          #050714 60%,
          #02030a 100%);
      --bg-card: rgba(20, 25, 50, 0.55);
      --bg-input: rgba(30, 35, 70, 0.65);

      /* Text */
      --text-main: #f1f4ff;
      --text-muted: #aab2d6;

      /* Borders */
      --border-color: rgba(120, 140, 255, 0.25);
    }


    * {
      box-sizing: border-box;
      font-family: "Segoe UI", Roboto, sans-serif;
    }

    body {
      margin: 0;
      background: radial-gradient(circle at top, #151821, #0f1115);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-main);
    }

    .profile-card {
      background: var(--bg-card);
      width: 100%;
      max-width: 420px;
      padding: 40px 32px;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      border: 1px solid var(--border-color);
      position: relative;
    }

    .profile-card h1 {
      margin: 0 0 24px;
      font-size: 24px;
      font-weight: 600;
      color: var(--text-main);
      text-align: center;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-main);
    }

    .form-group input {
      width: 100%;
      padding: 13px 14px;
      font-size: 15px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      background: var(--bg-input);
      color: var(--text-main);
      outline: none;
      transition: all 0.2s ease;
    }

    .form-group input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(255, 56, 92, 0.2);
    }

    .submit-btn {
      margin-top: 12px;
      width: 100%;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      background-color: var(--primary);
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .submit-btn:hover {
      background-color: var(--primary-hover);
      transform: translateY(-1px);
    }

    .submit-btn:active {
      transform: scale(0.98);
    }

    /* Professional square rounded back button */
    .back-btn {
      position: absolute;
      top: 20px;
      left: 20px;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      background: var(--bg-input);
      color: var(--text-main);
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    /* Hover effect */
    .back-btn:hover {
      background-color: var(--border-color);
      transform: translateY(-1px);
    }

    /* Click effect */
    .back-btn:active {
      transform: scale(0.94);
    }

    /* Focus (keyboard users) */
    .back-btn:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(255, 56, 92, 0.3);
    }
  </style>
</head>

<body>
  <div class="profile-card">
    <br><br>
    <button class="back-btn" onclick="window.location.href='/profile'">
      ←
    </button>
    <h1>Edit Profile</h1>


    <form action="/profile/edit-profile" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input id="name" type="text" name="name" value="<%= currentUser.name %>" required />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= currentUser.email %>" required />
      </div>

      <button type="submit" class="submit-btn">
        Update Profile
      </button>

    </form>

  </div>
</body>

</html>